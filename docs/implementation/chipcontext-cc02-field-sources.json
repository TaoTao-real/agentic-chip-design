{
  "extractors": {
    "verilator-differential-v3": {
      "fields": {
        "check.outcome": {
          "format": "unified reconciliation of early-exit, run fields, PASS/mismatch markers and supported explicit failures",
          "missing": "not_run or inconclusive; contradictory evidence is a conflict",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/passed and #/returncode",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "completed_cycles": {
          "format": "exact PASS cycles=N stdout marker matching configured upper bound",
          "missing": "not_collected",
          "producer": "Verilator differential testbench",
          "source": "stdout PASS marker byte and line span",
          "stages": [
            "correctness"
          ],
          "unit": "cycles"
        },
        "cycles": {
          "format": "exact JSON integer configured upper bound; not executed coverage",
          "missing": "parse_failed",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/cycles",
          "stages": [
            "correctness"
          ],
          "unit": "cycles"
        },
        "directed_phases": {
          "format": "JSON string array",
          "missing": "not_run for a native interface early exit; not_collected when other evidence implies execution; malformed present values are rejected",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/directed_phases",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "first_mismatch.cycle": {
          "format": "first grounded MISMATCH marker in stdout",
          "missing": "not_collected",
          "producer": "Verilator differential testbench",
          "source": "stdout byte and line span",
          "stages": [
            "correctness"
          ],
          "unit": "cycles"
        },
        "first_mismatch.expected_actual": {
          "format": "optional expected= and actual= values on the mismatch marker",
          "missing": "not_collected",
          "producer": "Verilator differential testbench",
          "source": "stdout byte and line span",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "first_mismatch.signal": {
          "format": "port= or signal= token on first grounded mismatch marker",
          "missing": "not_collected",
          "producer": "Verilator differential testbench",
          "source": "stdout byte and line span",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "interface_check": {
          "format": "JSON interface_ok boolean; false may stop before simulator launch",
          "missing": "not_collected",
          "producer": "tools/differential_test.py",
          "source": "result.json#/interface_ok",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "passed": {
          "format": "JSON boolean",
          "missing": "parse_failed",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/passed",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "producer_failure_class": {
          "format": "versioned producer failure label; only documented functional labels prove a behavior failure",
          "missing": "not_collected",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/failure_class",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "return_code": {
          "format": "JSON integer",
          "missing": "not_run for a native interface early exit; not_collected when other evidence implies execution; malformed present values are rejected",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/returncode",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "scenario": {
          "format": "JSON string",
          "missing": "parse_failed",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/scenario",
          "stages": [
            "correctness"
          ],
          "unit": null
        },
        "seed": {
          "format": "JSON integer",
          "missing": "parse_failed",
          "producer": "BoomDifferentialNode",
          "source": "result.json#/seed",
          "stages": [
            "correctness"
          ],
          "unit": null
        }
      }
    },
    "vivado-2024.1-v3": {
      "fields": {
        "clock_period_ns": {
          "definition_revision": "clock-constraint-v1",
          "format": "frozen physical contract",
          "missing": "not_collected",
          "producer": "FROZEN_RUN_MANIFEST physical contract",
          "source": "extraction configuration plus timing-summary span",
          "stages": [
            "post_synth",
            "post_route"
          ],
          "unit": "ns"
        },
        "critical_delay_ns": {
          "definition_revision": "timing-critical-delay-v1",
